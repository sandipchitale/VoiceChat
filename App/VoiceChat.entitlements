<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Spec R-SEC-6. Not App-Sandboxed in v1 (R-ARCH-7, rationale in §2.4):
         the rendezvous socket must be reachable by an unsandboxed MCP server
         spawned by an arbitrary host. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
